# PRIME-RL + ModelExpress weight broadcast — ARM64 (GB200)
#
# Build (cross-compile from x86 host):
#   docker buildx build --platform linux/arm64 \
#     -t nvcr.io/nvidian/dynamo-dev/prime-rl-mx:latest \
#     -f Dockerfile.mx-arm64 --push .
#
# Build (native on arm64):
#   docker build -t nvcr.io/nvidian/dynamo-dev/prime-rl-mx:latest \
#     -f Dockerfile.mx-arm64 .

ARG BASE_IMAGE=nvcr.io/nvidia/cuda:12.8.1-devel-ubuntu24.04
FROM ${BASE_IMAGE} AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-dev python3.12-venv python3-pip \
    git curl wget build-essential ninja-build pkg-config cmake \
    libibverbs-dev libnuma-dev autoconf automake libtool \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && python3 -m pip install --break-system-packages meson meson-python pybind11 numpy cython

# ---- Build UCX from source (NIXL HEAD needs newer UCX than distro ships) ----
RUN git clone --depth 1 -b v1.18.0 https://github.com/openucx/ucx.git /opt/ucx-src \
    && cd /opt/ucx-src \
    && ./autogen.sh \
    && ./configure --prefix=/opt/ucx-install --with-cuda=/usr/local/cuda --with-verbs --enable-mt \
    && make -j$(nproc) \
    && make install \
    && rm -rf /opt/ucx-src

ENV PATH="/opt/ucx-install/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/ucx-install/lib:${LD_LIBRARY_PATH}"
ENV PKG_CONFIG_PATH="/opt/ucx-install/lib/pkgconfig"
ENV C_INCLUDE_PATH="/opt/ucx-install/include"
ENV CPLUS_INCLUDE_PATH="/opt/ucx-install/include"

# ---- Build NIXL from source (ARM64-compatible) ----
RUN git clone --depth 1 https://github.com/ai-dynamo/nixl.git /opt/nixl-src
WORKDIR /opt/nixl-src

# Two-phase build: first configure, then compile with limited parallelism
# to avoid OOM on pybind11 template-heavy files under QEMU emulation.
RUN meson setup build \
    --prefix=/opt/nixl-install \
    -Ducx_path=/opt/ucx-install \
    -Denable_plugins=UCX \
    -Dbuildtype=release

# Compile with -j2 to stay within memory limits under QEMU arm64 emulation
RUN ninja -C build -j2 && meson install -C build

# Install NIXL Python package — meson already built it, just install the binding into site-packages
RUN cd /opt/nixl-src && \
    python3 -m pip install --break-system-packages --no-build-isolation . || \
    (echo "pip install failed, copying binding manually" && \
     mkdir -p /usr/local/lib/python3.12/dist-packages/nixl && \
     cp -r build/src/bindings/python/* /usr/local/lib/python3.12/dist-packages/nixl/ 2>/dev/null; \
     cp build/src/bindings/python/*.so /usr/local/lib/python3.12/dist-packages/nixl/ 2>/dev/null; \
     true)

# Debug: show where nixl ended up
RUN find /usr/local/lib/python3.12/dist-packages /opt/nixl-install -name "nixl*" -o -name "_bindings*" 2>/dev/null | head -20 || true

# ---- Install ModelExpress Python client ----
RUN python3 -m pip install --break-system-packages --no-deps \
    grpcio protobuf pydantic torch numpy huggingface_hub 2>/dev/null || true

RUN python3 -m pip install --break-system-packages --no-deps \
    "modelexpress @ git+https://github.com/ai-dynamo/modelexpress.git@kavink/RL#subdirectory=modelexpress_client/python"

# ---- Runtime image ----
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-dev python3.12-venv python3-pip \
    git libibverbs1 libnuma1 curl \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && python3 -m pip install --break-system-packages pip uv

# Copy UCX install from builder
COPY --from=builder /opt/ucx-install/ /opt/ucx-install/

# Copy NIXL installed libs from builder
COPY --from=builder /opt/nixl-install/ /opt/nixl-install/

# Copy entire Python site-packages from builder (includes nixl + modelexpress)
COPY --from=builder /usr/local/lib/python3.12/dist-packages/ /usr/local/lib/python3.12/dist-packages/

ENV LD_LIBRARY_PATH="/opt/ucx-install/lib:/opt/nixl-install/lib:/opt/nixl-install/lib/aarch64-linux-gnu:${LD_LIBRARY_PATH}"
ENV PATH="/opt/ucx-install/bin:${PATH}"

# ModelExpress client is included in the site-packages copy above

# ---- Install PRIME-RL via uv (respects lockfile for correct dep versions) ----
WORKDIR /opt/prime-rl
COPY pyproject.toml uv.lock README.md ./
COPY src/ src/

# Use uv to sync deps from the lockfile — handles version pinning correctly
# Skip x86-only extras (disagg) that won't build on arm64
RUN uv venv /opt/prime-rl/.venv && \
    VIRTUAL_ENV=/opt/prime-rl/.venv uv sync --frozen --no-install-project 2>/dev/null || \
    VIRTUAL_ENV=/opt/prime-rl/.venv uv sync --frozen --no-install-project --inexact 2>/dev/null || \
    (echo "uv sync failed, falling back to pip" && \
     /opt/prime-rl/.venv/bin/pip install \
       vllm "torchtitan @ git+https://github.com/pytorch/torchtitan.git" \
       tomli_w tomli httpx aiolimiter verifiers ring-flash-attn \
       wandb accelerate triton pyzmq tenacity hf-transfer \
       "pydantic-config @ git+https://github.com/PrimeIntellect-ai/pydantic-config.git" \
       2>/dev/null || true)

# flash-attn: comprehensive stub for arm64 (ring_flash_attn + vLLM rotary needs)
RUN SITE=/opt/prime-rl/.venv/lib/python3.12/site-packages && \
    mkdir -p $SITE/flash_attn/ops/triton $SITE/flash_attn-2.7.0.dist-info && \
    printf '%s\n' \
      '__version__ = "2.7.0"' \
      '_stub = "flash_attn stub on arm64"' \
      'def flash_attn_varlen_func(*a, **kw): raise NotImplementedError(_stub)' \
      'def flash_attn_func(*a, **kw): raise NotImplementedError(_stub)' \
      'def flash_attn_with_kvcache(*a, **kw): raise NotImplementedError(_stub)' \
      'def flash_attn_supports_top_left_mask(): return False' \
      > $SITE/flash_attn/__init__.py && \
    printf '%s\n' \
      'from flash_attn import flash_attn_varlen_func, flash_attn_func, flash_attn_with_kvcache' \
      '_flash_supports_window_size = False' \
      '_s = "flash_attn stub on arm64"' \
      'def _flash_attn_varlen_forward(*a, **kw): raise NotImplementedError(_s)' \
      'def _flash_attn_varlen_backward(*a, **kw): raise NotImplementedError(_s)' \
      'def _flash_attn_forward(*a, **kw): raise NotImplementedError(_s)' \
      'def _flash_attn_backward(*a, **kw): raise NotImplementedError(_s)' \
      > $SITE/flash_attn/flash_attn_interface.py && \
    touch $SITE/flash_attn/ops/__init__.py && \
    touch $SITE/flash_attn/ops/triton/__init__.py && \
    printf '%s\n' \
      'import torch' \
      'def apply_rotary(x, cos, sin, interleaved=False, conjugate=False):' \
      '    cos = cos[:x.shape[1]].unsqueeze(0).unsqueeze(2)' \
      '    sin = sin[:x.shape[1]].unsqueeze(0).unsqueeze(2)' \
      '    half = x.shape[-1] // 2' \
      '    x1, x2 = x[..., :half], x[..., half:]' \
      '    return torch.cat([x1 * cos - x2 * sin, x2 * cos + x1 * sin], dim=-1)' \
      > $SITE/flash_attn/ops/triton/rotary.py && \
    printf 'Metadata-Version: 2.1\nName: flash-attn\nVersion: 2.7.0\n' \
      > $SITE/flash_attn-2.7.0.dist-info/METADATA && \
    echo "flash_attn" > $SITE/flash_attn-2.7.0.dist-info/top_level.txt && \
    echo "flash-attn comprehensive stub installed for arm64"

# Install reverse-text env via uv (cache-bust: v5)
RUN curl -sL -o /tmp/reverse_text-0.1.5-py2.py3-none-any.whl \
    "https://hub.primeintellect.ai/primeintellect/reverse-text/@e3cd3fe4/reverse_text-0.1.5-py2.py3-none-any.whl" && \
    VIRTUAL_ENV=/opt/prime-rl/.venv uv pip install /tmp/reverse_text-0.1.5-py2.py3-none-any.whl && \
    rm /tmp/reverse_text-0.1.5-py2.py3-none-any.whl && \
    echo "reverse-text installed" || echo "reverse-text install failed"

# Install PRIME-RL itself into the venv (or system if venv failed)
RUN (VIRTUAL_ENV=/opt/prime-rl/.venv uv pip install --no-deps . 2>/dev/null) || \
    python3 -m pip install --break-system-packages --no-deps .

# Copy modelexpress and nixl_cu12 into venv, create nixl shim
RUN VSITE=/opt/prime-rl/.venv/lib/python3.12/site-packages && \
    cp -r /usr/local/lib/python3.12/dist-packages/modelexpress $VSITE/modelexpress && \
    cp -r /opt/nixl-install/lib/python3/dist-packages/nixl_cu12 $VSITE/nixl_cu12 && \
    mkdir -p $VSITE/nixl && \
    printf '%s\n' \
      'from nixl_cu12 import *' \
      'from nixl_cu12 import _api' \
      'from nixl_cu12 import _bindings' \
      > $VSITE/nixl/__init__.py && \
    cp $VSITE/nixl_cu12/_api.py $VSITE/nixl/_api.py 2>/dev/null || true && \
    echo "modelexpress + nixl_cu12 + nixl shim copied into venv"
# Ensure grpcio is in the venv (needed by MxClient)
RUN VIRTUAL_ENV=/opt/prime-rl/.venv uv pip install grpcio protobuf 2>/dev/null || true

# Make venv the default Python
ENV PATH="/opt/prime-rl/.venv/bin:${PATH}"
ENV VIRTUAL_ENV="/opt/prime-rl/.venv"

# Environment
ENV UCX_TLS=rc_x,rc,dc_x,dc,cuda_copy
ENV NIXL_LOG_LEVEL=INFO
ENV MODEL_EXPRESS_URL=modelexpress-server:8001

ENTRYPOINT ["python3", "-m"]
CMD ["prime_rl.entrypoints.rl"]
