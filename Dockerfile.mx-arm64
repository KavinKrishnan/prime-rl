# PRIME-RL + ModelExpress weight broadcast — ARM64 (GB200)
#
# Build (cross-compile from x86 host):
#   docker buildx build --platform linux/arm64 \
#     -t nvcr.io/nvidian/dynamo-dev/prime-rl-mx:latest \
#     -f Dockerfile.mx-arm64 --push .
#
# Build (native on arm64):
#   docker build -t nvcr.io/nvidian/dynamo-dev/prime-rl-mx:latest \
#     -f Dockerfile.mx-arm64 .

ARG BASE_IMAGE=nvcr.io/nvidia/cuda:12.8.1-devel-ubuntu24.04
FROM ${BASE_IMAGE} AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-dev python3.12-venv python3-pip \
    git curl wget build-essential ninja-build pkg-config cmake \
    libibverbs-dev libucx-dev \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && python3 -m pip install --break-system-packages meson meson-python pybind11 numpy cython

# ---- Build NIXL from source (ARM64-compatible) ----
RUN git clone --depth 1 https://github.com/ai-dynamo/nixl.git /opt/nixl-src
WORKDIR /opt/nixl-src

# Two-phase build: first configure, then compile with limited parallelism
# to avoid OOM on pybind11 template-heavy files under QEMU emulation.
RUN meson setup build \
    --prefix=/opt/nixl-install \
    -Denable_plugins=UCX \
    -Dbuildtype=release

# Compile with -j2 to stay within memory limits under QEMU arm64 emulation
RUN ninja -C build -j2 && meson install -C build

# Install NIXL Python package
RUN cd /opt/nixl-src && python3 -m pip install --break-system-packages --no-build-isolation . 2>/dev/null || \
    (cd /opt/nixl-src && pip install --break-system-packages --no-deps -e .) || true

# ---- Install ModelExpress Python client ----
RUN python3 -m pip install --break-system-packages --no-deps \
    grpcio protobuf pydantic torch numpy huggingface_hub 2>/dev/null || true

RUN python3 -m pip install --break-system-packages --no-deps \
    "modelexpress @ git+https://github.com/ai-dynamo/modelexpress.git@kavink/RL#subdirectory=modelexpress_client/python"

# ---- Runtime image ----
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-dev python3.12-venv python3-pip \
    git libibverbs1 libucx0 curl \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && python3 -m pip install --break-system-packages pip uv

# Copy NIXL installed libs and Python packages from builder
COPY --from=builder /opt/nixl-install/ /opt/nixl-install/
COPY --from=builder /usr/local/lib/python3.12/dist-packages/nixl/ /usr/local/lib/python3.12/dist-packages/nixl/
COPY --from=builder /usr/local/lib/python3.12/dist-packages/nixl*.dist-info/ /usr/local/lib/python3.12/dist-packages/nixl.dist-info/
ENV LD_LIBRARY_PATH="/opt/nixl-install/lib:${LD_LIBRARY_PATH}"

# Copy ModelExpress client from builder
COPY --from=builder /usr/local/lib/python3.12/dist-packages/modelexpress/ \
    /usr/local/lib/python3.12/dist-packages/modelexpress/

# ---- Install PRIME-RL ----
WORKDIR /opt/prime-rl
COPY pyproject.toml uv.lock ./
COPY src/ src/

# Install core deps first (without optional x86-only extras)
RUN python3 -m pip install --break-system-packages -e . 2>/dev/null || \
    python3 -m pip install --break-system-packages --no-deps -e .

# Install vLLM (arm64 wheel available)
RUN python3 -m pip install --break-system-packages vllm 2>/dev/null || true

# Install grpcio for MX client
RUN python3 -m pip install --break-system-packages grpcio protobuf pydantic 2>/dev/null || true

# Environment
ENV UCX_TLS=rc_x,rc,dc_x,dc,cuda_copy
ENV NIXL_LOG_LEVEL=INFO
ENV MODEL_EXPRESS_URL=modelexpress-server:8001

ENTRYPOINT ["python3", "-m"]
CMD ["prime_rl.entrypoints.rl"]
